# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS
.DS_Store

# Local Hugging Face cache (populated by scripts/cache_models.py)
hf_cache/

# Trained checkpoints: final_model/model.safetensors alone is ~411 MB, well over
# GitHub's 100 MB per-file hard limit. Keep test_metrics.json / run_info.json,
# which are small and are the actual reportable results.
outputs/**/final_model/
outputs/**/checkpoint-*/
outputs_old/**/final_model/
outputs_old/**/checkpoint-*/

# Tokenized dataset + raw splits (~205 MB), regenerated by
# data_annotation/data_annotation_notebook/bio_hf_dataset_prep.ipynb
bio_tagging/bio_dataset/
bio_tagging/bio_dataset_split/

# Slurm job logs
slurm/logs/*.out
slurm/logs/*.err
